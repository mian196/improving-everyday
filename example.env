# Database Connection URL
# By default, DevOps LMS runs in a zero-configuration SQLite mode. If DATABASE_URL is omitted, it automatically resolves to an absolute path of 'prisma/dev.db' at runtime.

# Custom local SQLite path example:
# DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL Example: "postgresql://username:password@localhost:5432/database"
DATABASE_URL="file:./prisma/dev.db"
